// Sponsor normalisation v2 — a model-built canonical registry.
//
// Read it as three bands, top to bottom:
//   1. deterministic and free      (blue)   — re-runnable at any time
//   2. paid LLM passes             (violet) — need an API key, capped at USD 60
//   3. emit, gate, and display     (green)  — what the app actually reads
//
// The one thing worth carrying away: every paid pass writes a content-addressed
// cache, so re-running resolves only absent keys and costs nothing. Regenerate
// with:  dot -Tpng rmarkdown/sponsor_normalisation_pipeline.dot -o rmarkdown/sponsor_normalisation_pipeline.png

digraph sponsor_normalisation_v2 {
  graph [
    rankdir    = TB,
    bgcolor    = "white",
    pad        = "0.4",
    nodesep    = "0.34",
    ranksep    = "0.5",
    // NOT ortho: graphviz silently drops edge labels under orthogonal
    // routing, and several edges here carry the load-bearing detail.
    splines    = polyline,
    fontname   = "Helvetica",
    outputorder = edgesfirst
  ];

  node [
    shape     = box,
    style     = "rounded,filled",
    fontname  = "Helvetica",
    fontsize  = 10,
    color     = "#6B7280",
    penwidth  = 1.2,
    fillcolor = "#F8FAFC",
    margin    = "0.13,0.09"
  ];

  edge [
    fontname  = "Helvetica",
    fontsize  = 8.5,
    color     = "#6B7280",
    arrowsize = 0.7
  ];

  // ── Source ─────────────────────────────────────────────────────────────────
  cache [label = "Trial cache\ntrials_cache.rds / trials.sqlite",
         fillcolor = "#E0F2FE", color = "#0284C7"];
  export [label = "1_export_trial_sponsors.R",
          fillcolor = "#DBEAFE", color = "#2563EB"];
  raw [label = "data/trial_sponsors_raw.csv\n50,359 rows · 16,594 distinct strings",
       fillcolor = "#EFF6FF", color = "#2563EB"];

  // ── Band 1: deterministic ──────────────────────────────────────────────────
  subgraph cluster_offline {
    label     = "Deterministic · offline · free";
    fontname  = "Helvetica-Bold";
    fontsize  = 10;
    color     = "#2563EB";
    style     = "rounded,dashed";
    bgcolor   = "#FBFDFF";

    block [label = "A_block.R\ncanopy blocking, seeded by trial impact\ndual fold: raw + diacritics-deleted",
           fillcolor = "#DBEAFE", color = "#2563EB"];
    blocks [label = "data/sponsor_blocks.csv\n2,438 multi-member blocks + 3,877 singletons",
            fillcolor = "#EFF6FF", color = "#2563EB"];
  }

  // ── Shared machinery ───────────────────────────────────────────────────────
  subgraph cluster_shared {
    label     = "helper_scripts/llm_norm/ — shared machinery, used by every pass above";
    fontname  = "Helvetica-Bold";
    fontsize  = 10;
    color     = "#94A3B8";
    style     = "rounded,dashed";
    bgcolor   = "#FAFAFA";

    client [label = "client.R\nONE constant schema per pass\nbudget guard · idempotent spend\nbatch results matched by custom_id",
            fillcolor = "#F1F5F9", color = "#64748B"];
    retrieve [label = "retrieve.R\nIDF token index · canopy · union-find",
              fillcolor = "#F1F5F9", color = "#64748B"];
    registry_mod [label = "registry.R\nmerge chains · human pinning\nexact-canonical collapse",
                  fillcolor = "#F1F5F9", color = "#64748B"];
    spend [label = "llm_spend.csv\n$10.31 of a $60 cap, from returned usage",
           fillcolor = "#FEFCE8", color = "#CA8A04"];
  }

  // ── Band 2: paid passes ────────────────────────────────────────────────────
  subgraph cluster_llm {
    label     = "Paid LLM passes · API key required · gate each with --sync --limit=N";
    fontname  = "Helvetica-Bold";
    fontsize  = 10;
    color     = "#7C3AED";
    style     = "rounded,dashed";
    bgcolor   = "#FDFBFF";

    mint [label = "B_mint.R\nname each cluster ONCE, every variant visible\nOpus 5 head (500 blocks) / Sonnet 5 tail\n--singletons · --retry-failed",
          fillcolor = "#F5F3FF", color = "#7C3AED"];
    clusters [label = "B_mint_clusters.csv\ncanonical = the BRAND, not the legal entity",
              fillcolor = "#FAF5FF", color = "#7C3AED"];

    assign [label = "C_assign.R\npick-from-list: model returns an INTEGER index,\nR bounds-checks it · 0 = abstain",
            fillcolor = "#F5F3FF", color = "#7C3AED"];

    translate [label = "D_consolidate.R --translate\nEnglish name as a blocking key\n(Gent/Ghent, Wien/Vienna)",
               fillcolor = "#F5F3FF", color = "#7C3AED"];
    consolidate [label = "D_consolidate.R\nPARTITION each group: one index per member\nnot one verdict per group",
                 fillcolor = "#F5F3FF", color = "#7C3AED"];
    merges [label = "D_consolidate_merges.csv\nreview before --apply",
            fillcolor = "#FAF5FF", color = "#7C3AED"];
  }

  // ── The registry ───────────────────────────────────────────────────────────
  registry [label = "config/sponsor_norm_v2/registry.csv\n6,954 live canonicals (7,238 rows, 284 merged away)",
            fillcolor = "#ECFDF5", color = "#059669"];
  assignments [label = "assignments.csv\n16,594 / 16,594 raw strings assigned",
               fillcolor = "#ECFDF5", color = "#059669"];

  // ── Band 3: emit and display ───────────────────────────────────────────────
  subgraph cluster_emit {
    label     = "Emit · gate · display";
    fontname  = "Helvetica-Bold";
    fontsize  = 10;
    color     = "#16A34A";
    style     = "rounded,dashed";
    bgcolor   = "#FAFFFB";

    emit [label = "E_emit.R\nthe only writer of the app-facing labels",
          fillcolor = "#DCFCE7", color = "#16A34A"];
    labels [label = "data/trial_sponsor_labels.csv\n50,359 / 50,359 trial rows · 0 unknown",
            fillcolor = "#DCFCE7", color = "#16A34A"];
    normlog [label = "data/sponsor_normalisation_log_v2.csv\nper-string audit log",
             fillcolor = "#DCFCE7", color = "#16A34A"];
    queue [label = "E_review_queue.csv\n2,130 low-confidence rows · 3,579 trial rows",
           fillcolor = "#FEFCE8", color = "#CA8A04"];
    gate [label = "E_emit.R --diff-only\nREGRESSION GATE\naccepted → unknown must be 0",
          shape = box, fillcolor = "#FEF2F2", color = "#DC2626", penwidth = 1.8];
    baseline [label = "trial_sponsor_labels_baseline.csv\nfrozen old-pipeline output",
              fillcolor = "#FFF7ED", color = "#EA580C"];
  }

  // ── Human curation, which outranks everything ──────────────────────────────
  subgraph cluster_human {
    label     = "Human curation — priority 1";
    fontname  = "Helvetica-Bold";
    fontsize  = 10;
    color     = "#DC2626";
    style     = "rounded,dashed";
    bgcolor   = "#FFFBFB";

    curation [label = "curation_app/\nreview the queue",
              fillcolor = "#FEE2E2", color = "#DC2626"];
    ledger [label = "config/review_ledger/review_decisions.csv\nappend-only · latest per raw string wins",
            fillcolor = "#FEE2E2", color = "#DC2626"];
  }

  app [label = "app.R", fillcolor = "#E0F2FE", color = "#0284C7"];
  display [label = "sponsor_label\n1 human · 2 pipeline · 3 raw\nsponsor_label_source records which",
           fillcolor = "#E0F2FE", color = "#0284C7", penwidth = 1.8];

  // ── Flow ───────────────────────────────────────────────────────────────────
  cache -> export -> raw;
  raw -> block -> blocks;

  blocks -> mint [label = "  multi-member"];
  blocks -> mint [label = "  singletons", style = dashed];
  mint -> clusters;

  clusters -> registry [label = "  materialise\n  (registry.R)"];
  clusters -> assignments;

  registry -> assign [label = "  candidates via retrieve.R"];
  assign -> assignments [label = "  index → entity_id"];

  registry -> translate;
  translate -> consolidate [label = "  English-name edges"];
  registry -> consolidate [label = "  token-overlap edges"];
  consolidate -> merges;
  merges -> registry [label = "  --apply\n  (guarded)", style = dashed];

  registry -> emit;
  assignments -> emit;
  emit -> labels;
  emit -> normlog;
  emit -> queue;
  labels -> gate [style = dashed];
  baseline -> gate [style = dashed];

  queue -> curation;
  curation -> ledger;

  labels -> app;
  ledger -> app [label = "  read on EVERY load,\n  never cached", color = "#DC2626", penwidth = 1.6];
  app -> display;

  // Deliberately NO edges from cluster_shared. Every pass uses those modules,
  // so drawing it produced six diagonals across the whole graph that said only
  // "everything uses everything" — clutter in exchange for nothing. The cluster
  // reads as a panel instead.
}
